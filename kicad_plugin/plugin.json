{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.emmertex.kicad-component-manager",
    "name": "KiCad Component Manager",
    "description": "Download LCSC parts and manage the project BOM in one window",
    "runtime": {
        "type": "python",
        "min_version": "3.10"
    },
    "actions": [
        {
            "identifier": "open",
            "name": "KiCad Component Manager",
            "description": "Download LCSC parts and manage the project BOM in one window",
            "show-button": true,
            "scopes": ["pcb", "schematic", "project_manager"],
            "entrypoint": "ipc_plugin.py",
            "icons-light": ["icon.png"],
            "icons-dark": ["icon.png"]
        }
    ]
}
